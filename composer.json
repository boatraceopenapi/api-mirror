{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "boa/hub",
    "description": "Boatrace Open API for Hub",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "shimomo",
            "email": "boa@shimomo.net"
        }
    ],
    "support": {
        "issues": "https://github.com/BoatraceOpenAPI/hub/issues",
        "source": "https://github.com/BoatraceOpenAPI/hub"
    },
    "require": {
        "php": "^8.5",
        "nesbot/carbon": "^2.63 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "BOA\\Hub\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BOA\\Hub\\Tests\\": "tests/"
        }
    }
}
